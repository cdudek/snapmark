{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); [ -x \"$r/.claude/hooks/plan-gate.sh\" ] || r=$CLAUDE_PROJECT_DIR; CLAUDE_PROJECT_DIR=$r exec \"$r/.claude/hooks/plan-gate.sh\"",
            "timeout": 345600,
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); [ -x \"$r/.claude/hooks/lint-on-edit.sh\" ] || r=$CLAUDE_PROJECT_DIR; CLAUDE_PROJECT_DIR=$r exec \"$r/.claude/hooks/lint-on-edit.sh\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); [ -x \"$r/.claude/hooks/gate-bash.sh\" ] || r=$CLAUDE_PROJECT_DIR; CLAUDE_PROJECT_DIR=$r exec \"$r/.claude/hooks/gate-bash.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); [ -x \"$r/.claude/hooks/chain-gate.sh\" ] || r=$CLAUDE_PROJECT_DIR; CLAUDE_PROJECT_DIR=$r exec \"$r/.claude/hooks/chain-gate.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); [ -x \"$r/.claude/hooks/session-check.sh\" ] || r=$CLAUDE_PROJECT_DIR; CLAUDE_PROJECT_DIR=$r exec \"$r/.claude/hooks/session-check.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); [ -x \"$r/.claude/hooks/verify-on-stop.sh\" ] || r=$CLAUDE_PROJECT_DIR; CLAUDE_PROJECT_DIR=$r exec \"$r/.claude/hooks/verify-on-stop.sh\"",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(.env*)", "Read(**/secrets/**)", "Read(**/.secrets/**)"]
  }
}
