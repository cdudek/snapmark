{
  "name": "snapmark",
  "version": "0.3.0",
  "private": true,
  "description": "Capture, annotate and collect screenshots into Markdown sessions",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc && cp src/editor.html dist/src/ && esbuild src/md-notes.ts --bundle --format=iife --global-name=MdNotes --minify --log-level=warning --outfile=dist/src/md-notes.js",
    "start": "npm run build && electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node dist/test/sessions.test.js && node dist/test/menu.test.js && node dist/test/exporter.test.js && vitest run tests/sdlc.test.ts",
    "smoke": "npm run build && electron dist/test/smoke.js",
    "dist": "npm run build && electron-builder --mac --publish never -c.mac.identity=-",
    "sdlc:tools": "curl -fsSL https://plannotator.ai/install.sh | bash && claude plugin marketplace add backnotprop/plannotator && claude plugin install plannotator@plannotator && npx skills add backnotprop/plannotator/apps/skills/extra --global --skill plannotator-setup-goal --agent claude-code --yes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@milkdown/kit": "^7.22.2",
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fabric": "^7.4.0",
    "marked": "^18.0.14"
  },
  "author": "Calvin Dudek",
  "repository": "github:cdudek/snapmark",
  "build": {
    "appId": "com.cdudek.snapmark",
    "productName": "Snapmark",
    "copyright": "\u00a9 2026 Calvin Dudek",
    "files": [
      "dist/src/**",
      "assets/*.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "LSUIElement": true
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Snapmark ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "cdudek",
      "repo": "snapmark"
    }
  }
}
